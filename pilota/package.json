{
  "name": "fisioagenda-pilota",
  "version": "0.1.0",
  "private": true,
  "description": "FisioAgenda — versione pilota condivisa (multiutente, solo dati fittizi)",
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,supavisor,mailpit,storage-api",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "start": "node tools/serve.js",
    "test": "node --test tests/engine.test.mjs tests/sheet.test.mjs",
    "test:server": "node --test --test-concurrency=1 tests/server.test.mjs tests/import.test.mjs tests/agenda.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build": "node tools/build.mjs",
    "test:e2e-vuoto": "node tests/e2e-vuoto.mjs",
    "test:e2e-agenda": "node tests/e2e-agenda.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "playwright": "^1.56.1",
    "supabase": "^2.119.0"
  },
  "license": "UNLICENSED"
}
